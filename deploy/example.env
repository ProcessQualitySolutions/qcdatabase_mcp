# Copy to the repo root as ".env" (gitignored) and edit.
# scripts/run-server.sh and the systemd unit both read it.

# REQUIRED: the public URL of this MCP server (the OAuth resource identifier).
QCDB_MCP_RESOURCE_URL=https://mcp.qcdatabase.ai

# Where the server listens. Keep it on loopback and put a TLS reverse proxy
# in front (deploy/nginx.conf or deploy/Caddyfile).
QCDB_MCP_HOST=127.0.0.1
QCDB_MCP_PORT=8000

# The OAuth authorization server users sign in against. Default is fine.
#QCDB_MCP_ISSUER_URL=https://qcdatabase.ai

# Extra Host/Origin allow-list entries (comma separated) if this server is
# reached under additional hostnames.
#QCDB_MCP_ALLOWED_HOSTS=
#QCDB_MCP_ALLOWED_ORIGINS=

# Transport hardening (both default ON; leave them on unless you know why).
# Stateless requests + plain JSON responses survive proxies, restarts, and
# multiple replicas. Set to 0 to restore stateful sessions / SSE responses.
#QCDB_MCP_STATELESS=1
#QCDB_MCP_JSON_RESPONSE=1

# Share per-user pinned-project state across replicas (needs the redis extra).
#QCDB_MCP_REDIS_URL=redis://localhost:6379/0

# Seconds a verified token is trusted before re-checking /api/whoami/.
#QCDB_MCP_TOKEN_CACHE_TTL=60
